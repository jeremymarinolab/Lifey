<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifey.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LIFEY_START_SCRIPT__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>WorkingDirectory</key>
  <string>__LIFEY_PROJECT_ROOT__</string>
  <key>StandardOutPath</key>
  <string>/Users/life/Library/Logs/Lifey/lifey.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/life/Library/Logs/Lifey/lifey-error.log</string>
</dict>
</plist>
